{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/lint/ascii_text.py\" --hook-json",
            "statusMessage": "Checking commit and PR text for non-ASCII"
          }
        ]
      }
    ]
  }
}
